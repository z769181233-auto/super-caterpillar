{
  "name": "@anime-studio-v2/database",
  "private": true,
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "validate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/anime_studio_v2?schema=public} prisma validate --schema prisma/schema.prisma",
